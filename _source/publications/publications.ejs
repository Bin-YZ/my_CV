```{=html}
<% let year = null; %>
<% for (const item of items) { %>
<% const y = String(item.date).slice(0,4); %>
<% if (y !== year) { if (year !== null) { %></ul><% } year = y; %>
<div class="pub-year"><%= y %></div>
<ul class="pubs list">
<% } %>
<li <%= metadataAttrs(item) %>><%= String(item.author).replace(/\.$/,'').split('Bin Xi').join('<strong>Bin Xi</strong>') %>. <span class="pub-title"><%= item.title %>.</span> <span class="pub-venue"><%= item.details %></span>.</li>
<% } %>
<% if (year !== null) { %></ul><% } %>
```
